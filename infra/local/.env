# Copier en .env puis adapter (make up le fait automatiquement). Le fichier .env n'est jamais versionné.

# ---- Versions des images : à fixer, jamais « latest » -------------------------------------------
REDPANDA_VERSION=v26.2.6
S3_CONNECTOR_VERSION=10.6.2
# MinIO : image maintenue par Chainguard. Seul le tag « latest » est gratuit, donc on fige par empreinte.
# Une fois que tout fonctionne, remplace la ligne ci-dessous par l'empreinte de TON image locale :
#   docker image inspect cgr.dev/chainguard/minio:latest --format '{{index .RepoDigests 0}}'
# ce qui donne MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:...
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
# À valider au premier lancement, puis à figer
CP_VERSION=7.9.0
CONSOLE_VERSION=latest
AWSCLI_VERSION=latest

# ---- Stockage objet local (identifiants de développement, jamais ceux d'un vrai compte) ------------
S3_ACCESS_KEY=dev-access-key  # login
S3_SECRET_KEY=minio_admin    # mot de passe
S3_BUCKET=velib-lake

# ---- Producteur Vélib' -------------------------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:18081
KAFKA_TOPIC=velib.station_status.v1
POLL_INTERVAL_S=60

# ---- Clé PRIM Île-de-France Mobilités (inscription gratuite), utilisée plus tard -----------------
PRIM_API_KEY=
